---
import JsonLd from "@websites/core/components/JsonLd.astro";
import { withBase } from "@websites/core/base";
import ButtonLink from "../ButtonLink.astro";
import ProjectCard from "../ProjectCard.astro";
import { profile } from "../../data/profile";
import { getFeaturedProjects } from "../../lib/cv";
import { useTranslations, type Lang } from "../../i18n/ui";
import { localizedPath } from "../../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = await getFeaturedProjects();

const copy = {
  de: { featured: "Ausgewählte Projekte" },
  en: { featured: "Selected projects" },
}[lang];

const site = Astro.site ?? new URL("http://localhost:4321");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role[lang],
  url: new URL(withBase(`/${lang}/`), site).href,
  sameAs: profile.links.map((link) => link.url),
};
---

<JsonLd data={person} />

<section class="hero">
  <p class="role">{profile.role[lang]}</p>
  <h1>{profile.name}</h1>
  <p class="intro">{profile.intro[lang]}</p>
  <div class="actions">
    <ButtonLink href={localizedPath(lang, "cv")}>{t("cta.cv")}</ButtonLink>
    <ButtonLink href={localizedPath(lang, "contact")} variant="secondary">
      {t("cta.contact")}
    </ButtonLink>
  </div>
</section>

{featured.length > 0 && (
  <section aria-labelledby="featured">
    <h2 id="featured">{copy.featured}</h2>
    <div class="grid">
      {featured.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
    <p>
      <a href={localizedPath(lang, "projects")}>{t("projects.all")} →</a>
    </p>
  </section>
)}

<style>
  .hero {
    padding-block: var(--space-section);
  }
  .role {
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-block-end: var(--space-2);
  }
  .intro {
    font-size: 1.25rem;
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
    margin-block-end: var(--space-4);
  }
</style>
