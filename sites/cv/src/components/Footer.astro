---
import { withBase } from "@websites/core/base";
import { profile } from "../data/profile";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav aria-label={t("footer.legal")}>
      <ul>
        <li>
          <a href={withBase("/de/impressum/")}>{t("footer.impressum")}</a>
        </li>
        <li>
          <a href={withBase("/de/datenschutz/")}>{t("footer.datenschutz")}</a>
        </li>
      </ul>
    </nav>
    <p>© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-section);
    border-block-start: var(--border-hairline);
  }
  .footer-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-muted);
    font-size: var(--fs-small);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    list-style: none;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }
  p {
    margin: 0;
    align-self: center;
  }
</style>
