---
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="tech">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}

<style>
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }
  .tech li {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    padding: 0 var(--space-2);
    border: var(--border-hairline);
    border-radius: 4px;
    color: var(--color-muted);
  }
</style>
