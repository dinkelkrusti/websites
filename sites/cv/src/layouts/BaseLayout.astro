---
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import Document from "@websites/core/components/Document.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import { getLangFromUrl } from "../i18n/utils";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  hideAlternates?: boolean;
  noindex?: boolean;
  lang?: Lang;
}

const { title, description, hideAlternates, noindex } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Document
  lang={lang}
  title={title}
  description={description}
  siteName={profile.name}
  hideAlternates={hideAlternates}
  noindex={noindex}
  skipLabel={t("skip")}
>
  <Header slot="header" lang={lang} pathname={Astro.url.pathname} />
  <slot />
  <Footer slot="footer" lang={lang} />
</Document>
