---
import "../styles/tokens.css";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ex nihilo</title>
    <meta name="robots" content="noindex" />
    <style>
      body {
        background: #131110;
        color: #f3eee3;
        font-family: system-ui, sans-serif;
        display: grid;
        place-items: center;
        min-height: 100svh;
        margin: 0;
      }
      a {
        color: #c9a24f;
        padding: 1rem;
      }
      ul {
        list-style: none;
        display: flex;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <ul>
      <li>
        <a href="de/">Deutsch</a>
      </li>
      <li>
        <a href="en/">English</a>
      </li>
    </ul>
    <script>
      const lang = navigator.language?.toLowerCase() ?? "de";
      location.replace(lang.startsWith("de") ? "de/" : "en/");
    </script>
  </body>
</html>
