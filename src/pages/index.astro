---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConcerts, formatConcertDate } from '../lib/concerts';
import { getPhotos } from '../lib/photos';

const { upcoming, past } = await getConcerts();
const photos = await getPhotos();
---
<BaseLayout title="ex nihilo — Duo" description="ex nihilo — klassisches Duo. [temp] Testseite 6.2.">
  <section style="padding-block: var(--space-section);">
    <h2>Konzerte (Collections-Test)</h2>
    <ul>
      {upcoming.map((c) => (
        <li>{formatConcertDate(c.data.date, 'de')} — {c.data.venue}, {c.data.city}</li>
      ))}
    </ul>
    <h3>Past: {past.length}</h3>
    <h2>Photos</h2>
    <ul>
      {photos.map((p) => (
        <li>{p.data.alt} (order {p.data.order})</li>
      ))}
    </ul>
  </section>
</BaseLayout>
