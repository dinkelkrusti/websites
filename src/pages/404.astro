  title="404 — ex nihilo"
  description="Seite nicht gefunden."
>
  <section class="nf">
    <h1>Seite nicht gefunden · Page not found</h1>
    <p>
      <a href="/de/">Deutsch</a> · <a href="/en/">English</a>
