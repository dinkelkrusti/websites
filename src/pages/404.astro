---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../i18n/utils";
---

<BaseLayout
  lang="de"
  title="404 — ex nihilo"
  description="Seite nicht gefunden."
>
  <section class="nf">
    <h1>Seite nicht gefunden · Page not found</h1>
    <p>
      <a href={withBase("/de/")}>Deutsch</a> ·{" "}
      <a href={withBase("/en/")}>English</a>
    </p>
  </section>
</BaseLayout>
<style>
  .nf {
    padding-block: var(--space-section);
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }
</style>
