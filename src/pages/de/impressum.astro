---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="de"
  title="Impressum — ex nihilo"
  description="Impressum und Anbieterkennzeichnung nach § 5 DDG."
  hideAlternates
>
  <section class="legal">
    <h1>Impressum</h1>
    <p>Angaben gemäß § 5 DDG:</p>
    <dl class="legal-list">
      <dt>Anbieter</dt>
      <dd>ex nihilo — Violeta Kadesha &amp; Jakob Grabenhorst GbR</dd>
      <dt>Anschrift</dt>
      <dd>Heinzenstraße 25, 52062 Aachen, Deutschland</dd>
      <dt>Vertretungsberechtigt</dt>
      <dd>Violeta Kadesha, Jakob Grabenhorst</dd>
      <dt>E-Mail</dt>
      <dd>
        <a href="mailto:violkadesha@yahoo.gr">violkadesha@yahoo.gr</a>
      </dd>
      <dt>Verantwortlich für den Inhalt i. S. d. § 18 Abs. 2 MStV</dt>
      <dd>Violeta Kadesha (Anschrift wie oben)</dd>
    </dl>
  </section>
</BaseLayout>
<style>
  .legal {
    padding-block: var(--space-section);
  }
  .legal-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
  }
  .legal-list dt {
    color: var(--color-text-soft);
  }
  .legal-list dd {
    margin: 0;
  }
</style>
