---
import PageHero from "../PageHero.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../i18n/utils";
import Button from "../Button.astro";

const { lang } = Astro.props as { lang: "de" | "en" };
const quotes = await getCollection("quotes");
const strings = {
  de: {
    quotes: "Stimmen",
    kit: "Pressemappe",
    kitNote:
      "Bios, Fotos und Kontakt auf einer Seite — per Strg+P auch als PDF exportierbar.",
    kitOpen: "Pressemappe öffnen",
    rider: "Technik: Dach, Essen und Getränke.",
  },
  en: {
    quotes: "Voices",
    kit: "Press kit",
    kitNote:
      "German-language press kit with bios, photos and contact details — also exports as a PDF via Ctrl+P.",
    kitOpen: "Open press kit",
    rider: "Technical requirements: Roof, Food, and Drinks.",
  },
}[lang];
---

<PageHero
  lang={lang}
  kicker="Presse"
  title={lang === "de" ? "Presse" : "Press"}
  intro={
    lang === "de"
      ? "Für Veranstalter und Journalisten."
      : "For promoters and journalists."
  }
/>

<section>
  <h2>{strings.quotes}</h2>
  {quotes.map((quote) => (
    <blockquote lang={lang === "en" ? "de" : undefined}>
      <p>„{quote.data.quote}“</p>
      <footer>
        {quote.data.url ? (
          <a href={quote.data.url}>{quote.data.source}</a>
        ) : (
          <cite>{quote.data.source}</cite>
        )}
      </footer>
    </blockquote>
  ))}
</section>

<section>
  <h2>{strings.kit}</h2>
  <p>{strings.kitNote}</p>
  <Button href={withBase("/de/presse-kit/")} variant="secondary">
    {strings.kitOpen}
  </Button>
  <p class="rider">{strings.rider}</p>
</section>

<style>
  blockquote {
    margin-block: var(--space-5);
    max-width: 60ch;
    border-inline-start: var(--border-hairline);
    padding-inline-start: var(--space-5);
  }
  blockquote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.375rem;
  }
  blockquote footer {
    font-size: var(--fs-small);
    color: var(--color-text-soft);
  }
  cite {
    font-style: normal;
  }
  .rider {
    color: var(--color-text-soft);
  }
</style>
