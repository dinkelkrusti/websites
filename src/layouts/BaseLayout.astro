---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, stripBase, withBase } from "../i18n/utils";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  hideAlternates?: boolean;
  lang?: Lang;
}

const { title, description, hideAlternates } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other: Lang = lang === "de" ? "en" : "de";
// [temp] string surgery on pathname — fine at 5 pages, revisit if slugs get complex
const cleanPath = stripBase(Astro.url.pathname);
const alternatePath = withBase(
  cleanPath.replace(/^\/(de|en)(?=\/|$)/, `/${other}`),
);
const site = Astro.site ?? new URL("http://localhost:4321");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    {!hideAlternates && (
      <>
        <link
          rel="alternate"
          hreflang={lang}
          href={new URL(Astro.url.pathname, site)}
        />
        <link
          rel="alternate"
          hreflang={other}
          href={new URL(alternatePath, site)}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(withBase("/"), site)}
        />
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />
    <meta property="og:site_name" content="ex nihilo" />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <!-- [temp] add public/og.jpg (1200x630) before launch, or remove this line until then -->
    <meta
      property="og:image"
      content={new URL(withBase("/og.jpg"), site).href}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("skip")}
    </a>
    <Header lang={lang} pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
