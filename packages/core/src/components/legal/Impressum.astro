---
/**
 * Provider identification according to § 5 DDG (Digitale-Dienste-Gesetz).
 * Fill only what applies; the page itself is German only.
 */
interface Props {
  /** Name, plus legal form for companies, e.g. "Erika Muster" or "… GbR" */
  provider: string;
  /** Full postal address — a P.O. box is not sufficient */
  address: string;
  email: string;
  phone?: string;
  /** Required for companies and partnerships (GbR, GmbH, …) */
  representatives?: string;
  /**
   * Only for journalistic-editorial content such as a blog or news:
   * § 18 Abs. 2 MStV. A CV or portfolio usually does not need it.
   */
  contentResponsible?: string;
}

const { provider, address, email, phone, representatives, contentResponsible } =
  Astro.props;
---

<section class="impressum">
  <h1>Impressum</h1>
  <p>Angaben gemäß § 5 DDG:</p>
  <dl class="legal-list">
    <dt>Anbieter</dt>
    <dd>{provider}</dd>
    <dt>Anschrift</dt>
    <dd>{address}</dd>
    {
      representatives && (
        <>
          <dt>Vertretungsberechtigt</dt>
          <dd>{representatives}</dd>
        </>
      )
    }
    <dt>E-Mail</dt>
    <dd>
      <a href={`mailto:${email}`}>{email}</a>
    </dd>
    {
      phone && (
        <>
          <dt>Telefon</dt>
          <dd>{phone}</dd>
        </>
      )
    }
    {
      contentResponsible && (
        <>
          <dt>Verantwortlich für den Inhalt i. S. d. § 18 Abs. 2 MStV</dt>
          <dd>{contentResponsible}</dd>
        </>
      )
    }
  </dl>
</section>

<style>
  .impressum {
    padding-block: var(--space-section);
  }
  .legal-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
  }
  .legal-list dt {
    color: var(--color-muted);
  }
  .legal-list dd {
    margin: 0;
  }
  /* Long terms (MStV line) would force horizontal scrolling on phones */
  @media (max-width: 40rem) {
    .legal-list {
      grid-template-columns: 1fr;
    }
    .legal-list dd {
      margin-block-end: var(--space-3);
    }
  }
</style>
